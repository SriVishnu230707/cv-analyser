{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CV Analyser evidence report v1.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "analysis_id",
    "status",
    "resume_sections",
    "requirements",
    "matches",
    "requirements_not_evidenced",
    "qualifications",
    "scores",
    "readability",
    "suggestions",
    "warnings",
    "input_hash",
    "scoring_policy_version",
    "taxonomy_version",
    "rule_version",
    "informational_requirement_count",
    "possible_evidence"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1.0"
    },
    "analysis_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "complete",
        "insufficient_requirements",
        "extraction_failed"
      ]
    },
    "resume_sections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "text"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        }
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/requirement"
      }
    },
    "matches": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/match"
      }
    },
    "requirements_not_evidenced": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "qualifications": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requirement_id",
          "status",
          "evidence",
          "reason"
        ],
        "properties": {
          "requirement_id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "met",
              "not_evidenced",
              "uncertain"
            ]
          },
          "evidence": {
            "oneOf": [
              {
                "$ref": "#/$defs/evidence"
              },
              {
                "type": "null"
              }
            ]
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "overall",
        "components"
      ],
      "properties": {
        "overall": {
          "$ref": "#/$defs/score"
        },
        "components": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "required_skills",
            "preferred_skills",
            "responsibilities"
          ],
          "properties": {
            "required_skills": {
              "$ref": "#/$defs/component"
            },
            "preferred_skills": {
              "$ref": "#/$defs/component"
            },
            "responsibilities": {
              "$ref": "#/$defs/component"
            }
          }
        }
      }
    },
    "readability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "issues"
      ],
      "properties": {
        "status": {
          "enum": [
            "not_assessed",
            "readable",
            "needs_review",
            "failed"
          ]
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "suggestions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "priority",
          "requirement_ids",
          "rationale",
          "action",
          "rewrite",
          "id",
          "kind",
          "evidence"
        ],
        "properties": {
          "priority": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "requirement_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "rationale": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "rewrite": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "missing_skill",
              "listed_skill",
              "responsibility_gap",
              "evidence_review",
              "qualification_review",
              "readability",
              "confirmed_evidence",
              "bullet_clarity"
            ]
          },
          "evidence": {
            "oneOf": [
              {
                "$ref": "#/$defs/evidence"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "input_hash": {
      "type": "string"
    },
    "scoring_policy_version": {
      "type": "string"
    },
    "taxonomy_version": {
      "type": "string"
    },
    "rule_version": {
      "type": "string"
    },
    "informational_requirement_count": {
      "type": "integer",
      "minimum": 0
    },
    "possible_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requirement_id",
          "evidence",
          "reason",
          "decision"
        ],
        "properties": {
          "requirement_id": {
            "type": "string"
          },
          "evidence": {
            "$ref": "#/$defs/evidence"
          },
          "reason": {
            "type": "string"
          },
          "decision": {
            "enum": [
              "pending",
              "accept",
              "reject"
            ]
          }
        }
      }
    },
    "ats_assessment": {
      "type": "object",
      "required": [
        "score",
        "label",
        "method",
        "readability_status",
        "disclaimer"
      ],
      "properties": {
        "score": {
          "$ref": "#/$defs/score"
        },
        "label": {
          "type": "string"
        },
        "method": {
          "type": "string"
        },
        "readability_status": {
          "type": "string"
        },
        "disclaimer": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "ai_analysis": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "complete"
          }
        }
      },
      "then": {
        "properties": {
          "scores": {
            "properties": {
              "overall": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "insufficient_requirements",
              "extraction_failed"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "scores": {
            "properties": {
              "overall": {
                "type": "null"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "extraction_failed"
          }
        }
      },
      "then": {
        "properties": {
          "matches": {
            "maxItems": 0
          },
          "readability": {
            "properties": {
              "status": {
                "const": "failed"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "score": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 100
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text",
        "section",
        "section_index",
        "start",
        "end"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "section": {
          "type": "string"
        },
        "section_index": {
          "type": "integer",
          "minimum": 0
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "requirement": {
      "type": "object",
      "required": [
        "id",
        "name",
        "category",
        "source",
        "sources",
        "weight",
        "classification_method",
        "needs_review",
        "review_reason",
        "canonical_skill",
        "included_in_score"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^job-[a-f0-9]{12}$"
        },
        "name": {
          "type": "string"
        },
        "category": {
          "type": "string",
          "enum": [
            "required_skill",
            "preferred_skill",
            "unclassified_skill",
            "responsibility",
            "mandatory_qualification",
            "qualification",
            "experience_requirement",
            "other_requirement",
            "excluded"
          ]
        },
        "source": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "text",
              "line_number"
            ],
            "additionalProperties": false,
            "properties": {
              "text": {
                "type": "string"
              },
              "line_number": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        "weight": {
          "enum": [
            0,
            1
          ]
        },
        "classification_method": {
          "enum": [
            "explicit",
            "heading",
            "inferred",
            "user"
          ]
        },
        "needs_review": {
          "type": "boolean"
        },
        "review_reason": {
          "type": "string"
        },
        "canonical_skill": {
          "type": [
            "string",
            "null"
          ]
        },
        "included_in_score": {
          "type": "boolean"
        }
      }
    },
    "match": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement_id",
        "status",
        "method",
        "evidence"
      ],
      "properties": {
        "requirement_id": {
          "type": "string"
        },
        "status": {
          "enum": [
            "listed",
            "demonstrated"
          ]
        },
        "method": {
          "enum": [
            "exact",
            "alias",
            "rule",
            "user_confirmed"
          ]
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "score",
        "base_weight",
        "effective_weight",
        "credited_weight",
        "total_weight"
      ],
      "properties": {
        "score": {
          "$ref": "#/$defs/score"
        },
        "base_weight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "effective_weight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "credited_weight": {
          "type": "number",
          "minimum": 0
        },
        "total_weight": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}
