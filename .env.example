# Copy to .env in the repository root. Never commit the real key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Required for LAN/hosted access. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
CV_API_TOKEN=
# Optional comma-separated browser origins for a local web deployment.
CV_ALLOWED_ORIGINS=
